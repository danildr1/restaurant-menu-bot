# Telegram
BOT_TOKEN=

# Универсальное подключение к LLM-провайдеру.
# Для router.cheap используйте URL ниже и укажите свой ключ в LLM_API_KEY.
LLM_API_KEY=
LLM_BASE_URL=https://router.cheap/v1

# Идентификаторы моделей у провайдера. При необходимости замените на доступные вам.
TEXT_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
